---
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/jetbrains-mono/latin-ext-500.css';
import '@fontsource/jetbrains-mono/latin-ext-600.css';
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-500.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '@fontsource/atkinson-hyperlegible-next/latin-ext-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-ext-500.css';
import '@fontsource/atkinson-hyperlegible-next/latin-ext-700.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, HREFLANG, OG_LOCALE, DEFAULT_LOCALE, page, url, type Locale } from '../lib/i18n';
import { texts, company } from '../lib/content';

interface Props {
  locale: Locale;
  slug?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale, slug = '', title, description, noindex = false } = Astro.props;
const t = texts(locale);
const pageTitle = title ? `${title} — ${company.name}` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(page(locale, slug));
const ogImage = abs(url('/og.png'));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: company.name,
  url: abs(page(DEFAULT_LOCALE)),
  email: company.email,
  description: texts(DEFAULT_LOCALE).meta.description,
  areaServed: 'NL',
  knowsLanguage: ['nl', 'en', 'tr'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.postal_code,
    addressLocality: company.city,
    addressCountry: 'NL',
  },
  founder: {
    '@type': 'Person',
    name: company.founder,
    sameAs: [company.github_personal_url, company.linkedin_url].filter(Boolean),
  },
  identifier: { '@type': 'PropertyValue', propertyID: 'KvK', value: company.kvk },
  ...(company.vat_id ? { vatID: company.vat_id } : {}),
  sameAs: [company.github_url, company.linkedin_url].filter(Boolean),
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!noindex && LOCALES.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={abs(page(l, slug))} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(page(DEFAULT_LOCALE, slug))} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon.png')} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#15233B" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var theme, motion;
        try {
          theme = localStorage.getItem('theme');
          motion = localStorage.getItem('motion');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.dataset.theme = theme;
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (motion === 'off' || (motion !== 'on' && reduced)) {
          d.dataset.motion = 'off';
        } else {
          d.dataset.motion = 'on';
          d.classList.add('motion-ok');
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header locale={locale} slug={slug} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
