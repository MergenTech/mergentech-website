---
import { texts } from '../lib/content';
import { getOss } from '../lib/oss';
import settings from '../content/oss.json';
import type { Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = texts(locale);
const oss = await getOss();
---
<section class="section section-alt" id="opensource" aria-labelledby="oss-title">
  <div class="wrap oss-layout">
    <div class="oss-copy" data-reveal>
      <span class="eyebrow">{t.oss.eyebrow}</span>
      <h2 class="h2" id="oss-title">{t.oss.title}</h2>
      <p>{t.oss.text}</p>
      <a class="btn btn-ghost" href={oss.url}>{t.oss.button} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>

    <div class="console" data-inview>
      <p class="console-cmd" aria-hidden="true">$ gh pr list -R {settings.repo} -A {settings.author}</p>
      {oss.items.length > 0 ? (
        <>
          <ol role="list">
            {oss.items.map((pr, i) => (
              <li style={`--i:${i}`}>
                <span class="pr-num">#{pr.number}</span>
                <span class="pr-title" lang="en">{pr.title}</span>
                <span class={`pr-state is-${pr.state}`}>{pr.state === 'merged' ? t.oss.merged : t.oss.open}</span>
              </li>
            ))}
          </ol>
          <p class="console-sum" style={`--i:${oss.items.length}`}>
            <a href={oss.url}>{oss.total} {t.oss.summary}</a>
          </p>
        </>
      ) : (
        <p class="console-sum" style="--i:0"><a href={oss.url}>{t.oss.fallback}</a></p>
      )}
    </div>
  </div>
</section>
