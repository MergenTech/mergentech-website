---
// Het beeldmerk: afgeronde vierkant met prompt (>) en oranje punt.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <rect class="mark-box" width="100" height="100" rx="22"></rect>
  <path class="mark-chevron" d="M29 29 L53 50 L29 71" fill="none" stroke-width="11.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <circle class="mark-dot" cx="70" cy="69" r="7.5" fill="#C2571A"></circle>
</svg>
