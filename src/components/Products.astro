---
import { texts, products } from '../lib/content';
import { asset, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = texts(locale);
const statusLabel = { development: t.products.status_development, pilot: t.products.status_pilot, soon: t.products.status_soon, live: t.products.status_live };
const tiles = [
  { l: 'K', x: 104, y: 22, top: true },
  { l: 'E', x: 88, y: 56 }, { l: 'L', x: 120, y: 56 },
  { l: 'İ', x: 72, y: 90 }, { l: 'M', x: 104, y: 90 }, { l: 'E', x: 136, y: 90 },
];
---
<section class="section section-alt" id="products" aria-labelledby="products-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{t.products.eyebrow}</span>
      <h2 class="h2" id="products-title">{t.products.title}</h2>
    </div>
    <div class="grid-3">
      {products.map((p) => {
        const c = p[locale];
        const href = p.url || '#contact';
        return (
          <article class="card product" data-reveal>
            <div class="product-visual" aria-hidden="true">
              {p.image ? (
                <img src={asset(p.image)} alt="" loading="lazy" />
              ) : p.icon ? (
                <img class="product-icon" src={asset(p.icon)} alt="" width="104" height="104" />
              ) : p.visual === 'letters' ? (
                <svg class="viz" viewBox="0 0 240 140" focusable="false">
                  {tiles.map((tile, i) => (
                    <g class="tile-g" style={`--i:${i}`}>
                      <rect class={tile.top ? 'tile tile-top' : 'tile'} x={tile.x} y={tile.y} width="28" height="28" rx="6"></rect>
                      <text class="tile-letter" x={tile.x + 14} y={tile.y + 20}>{tile.l}</text>
                    </g>
                  ))}
                </svg>
              ) : (
                <svg class="viz" viewBox="0 0 240 140" focusable="false">
                  <rect class="paper" x="76" y="14" width="96" height="116" rx="6"></rect>
                  <rect class="line-strong" x="110" y="28" width="48" height="7" rx="2"></rect>
                  <rect class="line" x="110" y="48" width="50" height="4" rx="2"></rect>
                  <rect class="line" x="110" y="58" width="42" height="4" rx="2"></rect>
                  <rect class="line" x="110" y="68" width="48" height="4" rx="2"></rect>
                  <rect class="line" x="110" y="88" width="50" height="26" rx="3"></rect>
                  <rect class="tagbox" style="--i:0" x="84" y="25" width="20" height="13" rx="3"></rect>
                  <text class="tagtext" style="--i:0" x="94" y="34.5" text-anchor="middle">H1</text>
                  <rect class="tagbox" style="--i:1" x="84" y="46" width="20" height="13" rx="3"></rect>
                  <text class="tagtext" style="--i:1" x="94" y="55.5" text-anchor="middle">P</text>
                  <rect class="tagbox" style="--i:2" x="84" y="94" width="20" height="13" rx="3"></rect>
                  <text class="tagtext" style="--i:2" x="94" y="103.5" text-anchor="middle">Alt</text>
                  <circle class="ok" cx="172" cy="126" r="13"></circle>
                  <path d="M166 126 l4.5 4.5 l8 -9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              )}
            </div>
            <div class="product-head">
              <h3>{p.name}</h3>
              <span class="status">{statusLabel[p.status] ?? p.status}</span>
            </div>
            <p class="product-tagline">{c.tagline}</p>
            <p>{c.text}</p>
            {c.cta && (
              <a class="link-arrow" href={href}>{c.cta} <span class="arrow" aria-hidden="true">→</span></a>
            )}
            {(p.app_store_url || p.play_url) && (
              <ul class="store-links" role="list">
                {p.app_store_url && (
                  <li>
                    <a class="btn btn-ghost btn-store" href={p.app_store_url} aria-label={t.products.store_app_store.replace('{name}', p.name)}>
                      App Store <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                )}
                {p.play_url && (
                  <li>
                    <a class="btn btn-ghost btn-store" href={p.play_url} aria-label={t.products.store_google_play.replace('{name}', p.name)}>
                      Google Play <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                )}
              </ul>
            )}
          </article>
        );
      })}
      {products.length % 3 !== 0 && (
        <div class="card product product-more" data-reveal>
          <h3>{t.products.more_title}</h3>
          <p>{t.products.more_text}</p>
        </div>
      )}
    </div>
  </div>
</section>
