---
import Mark from './Mark.astro';
import { LOCALES, LOCALE_NAMES, HREFLANG, page, type Locale } from '../lib/i18n';
import { texts } from '../lib/content';

interface Props { locale: Locale; slug?: string }
const { locale, slug = '' } = Astro.props;
const t = texts(locale);
const home = page(locale);
const links = [
  { id: 'services', label: t.nav.services },
  { id: 'work', label: t.nav.work },
  { id: 'products', label: t.nav.products },
  { id: 'opensource', label: t.nav.opensource },
  { id: 'about', label: t.nav.about },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={home} aria-label={t.nav.home}>
      <Mark class="brand-mark" />
      <span class="brand-word">
        <span class="brand-name">mergen</span>{' '}<span class="brand-tech">TECH</span>
      </span>
    </a>

    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      {t.nav.menu}
    </button>

    <div class="header-panel" id="site-nav" data-menu>
      <nav aria-label={t.nav.menu}>
        <ul class="nav-list" role="list">
          {links.map((l) => <li><a href={`${home}#${l.id}`}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="header-tools">
        <ul class="lang" role="list" aria-label={t.nav.language}>
          {LOCALES.map((l) => (
            <li>
              <a href={page(l, slug)} lang={l} hreflang={HREFLANG[l]} aria-current={l === locale ? 'true' : undefined}>
                {l.toUpperCase()}<span class="sr-only"> {LOCALE_NAMES[l]}</span>
              </a>
            </li>
          ))}
        </ul>

        <button type="button" class="tool" aria-pressed="false" data-theme-toggle>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path></svg>
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <span class="sr-only">{t.nav.theme}</span>
        </button>

        <button type="button" class="tool" aria-pressed="true" title={t.nav.motion} data-motion-toggle>
          <svg data-on width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
          <svg data-off width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.500 4.640A1 1 0 0 0 8 5.5z"></path></svg>
          <span class="sr-only">{t.nav.motion}</span>
        </button>

        <a class="btn btn-primary" href={`${home}#contact`}>{t.nav.cta}</a>
      </div>
    </div>
  </div>
  <div class="scroll-progress" aria-hidden="true"></div>
</header>
